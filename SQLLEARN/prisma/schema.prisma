
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users{
user_id   String @id
nom String @unique
mail String @unique
password  String 
role String @default("users")
createdAt DateTime @default(now())
updateAt  DateTime @updatedAt

tasks Tasks[] @relation("usertasks")
}

model Tasks{
  task_id String @id @default(uuid(7))
  task String
  creatAt DateTime @default(now())
  UpdateAt DateTime @updatedAt
  
  user_id String
  user  Users @relation("usertasks", fields: [user_id], references: [user_id] )
}
