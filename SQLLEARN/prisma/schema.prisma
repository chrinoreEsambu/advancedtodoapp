
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users{
user_id   String @id
nom String @unique
mail String @unique
password  String 
role String @default("users")
createdAt DateTime @default(now())
updateAt  DateTime @updatedAt

tasks Tasks[] @relation("usertasks")

// tasksCreated  Tasks[] @relation("TaskCreated")
// tasksAssigned Tasks[] @relation("TaskAssigned")
}

model Tasks {
  task_id     String   @id @default(uuid())
  taskUser    String
  state       String   @default("non assignée")
  
  userId   String
  fromAdmin   Users?   @relation("TaskCreated", fields: [userId], references: [user_id])

  toUserId String
  assignedTo  Users?   @relation("TaskAssigned", fields: [toUserId], references: [user_id])

  createdAt   DateTime @default(now())
}
