
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users{
user_id   String @id
nom String @unique
mail String @unique
password  String 
role String @default("users")

tasks Tasks[] @relation("usertasks")

taskCreatBy Tasks[] @relation("taskCreatByAdmin")

taskassignedto Tasks[] @relation("taskassignedto")

createdAt DateTime @default(now())
updateAt  DateTime @updatedAt
}

model Tasks{ 
  task_id String @id @default(uuid(7))
  task String
  state String? @default("pendding")
  
  user_id String
  user  Users @relation("usertasks", fields: [user_id], references: [user_id] )

  fromAdminId String?
  fromAdmin Users? @relation("taskCreatByAdmin", fields:[fromAdminId],references: [user_id])

  assignToId String?
  assignTo Users? @relation("taskassignedto",fields: [assignToId],references: [user_id])

  creatAt DateTime @default(now())
  UpdateAt DateTime @updatedAt
}
