
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users{
user_id   String @id
nom String @unique
mail String @unique
password  String 
role String @default("users")
createdAt DateTime @default(now())
updateAt  DateTime @updatedAt

tasks Tasks[] @relation("usertasks")

taskCreatBy Tasks[] @relation("taskCreatBy")
taskassignedto Tasks[] @relation("taskassignedto")
}

model Tasks{ 
  task_id String @id @default(uuid(7))
  task String
  state String @default("pendding")

  creatAt DateTime @default(now())
  UpdateAt DateTime @updatedAt
  
  user_id String
  user  Users @relation("usertasks", fields: [user_id], references: [user_id] )

  fromAdminId String
  fromAdmin Users @relation("taskCreatBy", fields:[fromAdminId],references: [user_id])

  assignToId String
  assignTo Users @relation("taskassignedto",fields: [assignToId],references: [user_id])
}
