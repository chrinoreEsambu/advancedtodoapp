generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Users {
  user_id   String   @id
  nom       String   @unique
  mail      String   @unique
  password  String  
  role      String   @default("users")
  
  createdTasks Tasks[] @relation("createdTasks") 
  assignedTasks Tasks[] @relation("assignedTasks") 
  adminAssignedTasks Tasks[] @relation("adminAssignedTasks")

  logRelation Logs[] @relation("logRelation")

  by Comments[] @relation("by")

  replyBy Comments[] @relation("replyBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TaskState {
  todo
  inprogress
  request
  denied
  accepted
  done
}
model Tasks {
  task_id    String   @id @default(uuid())
  
  task       String?
  description String? @db.VarChar(600)

  state      String?   @default("pending")

  taskState  TaskState? @default(todo)

  creatorId  String?
  creator    Users?    @relation("createdTasks", fields: [creatorId], references: [user_id])
 
  assignedById String?
  assignedBy  Users?  @relation("adminAssignedTasks", fields: [assignedById], references: [user_id])
 
  assigneeId String?
  assignee   Users ?   @relation("assignedTasks", fields: [assigneeId], references: [user_id])

  taskfor Comments[] @relation("taskfor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Logs{
  id String @id @default(uuid())
  adminId  String
  action String
  details String
  createAt DateTime @default(now())

  admin Users @relation("logRelation", fields: [adminId],references: [user_id])
}
model Comments {
id String @id @default(uuid())

content String

taskId String?
task Tasks? @relation("taskfor",fields:[taskId], references: [task_id] )

authorId  String
author Users @relation("by",fields: [authorId], references: [user_id])

replyById String?
replyBy Users? @relation("replyBy", fields: [replyById], references: [user_id])

replyToId String?
replyTo Comments? @relation("replyRelation", fields: [replyToId], references: [id])
replyRelation Comments[] @relation("replyRelation")

createdAt DateTime @default(now())
}

model Session {
  id           String   @id
  sid          String   @unique
  data         String
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
}
